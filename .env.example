# --- Browser defaults for the connection form ---
# /stardog goes through the Vite dev proxy below (recommended; avoids CORS).
VITE_STARDOG_ENDPOINT=/stardog
VITE_STARDOG_DB=
# Optional. Leave blank to use the proxy credentials below.
VITE_STARDOG_TOKEN=

# --- Dev proxy (server-side only, never sent to the browser) ---
# Local Stardog (Docker / Stardog Desktop) is the default.
STARDOG_URL=http://localhost:5820
# Optional Basic auth the proxy adds to every request. Put real values only in .env (gitignored).
STARDOG_USERNAME=
STARDOG_PASSWORD=
# For Stardog Cloud: STARDOG_URL=https://<your-endpoint>.stardog.cloud:5820 and use a Bearer token in the app.
